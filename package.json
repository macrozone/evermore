{
  "name": "evermore",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm catenv && node --env-file=.env.local --run dev:apps",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:ports && pnpm test:screenshot && pnpm test:db-setup && turbo run test",
    "catenv": "node --experimental-strip-types scripts/ensure-base-port.ts && catenv",
    "catladder": "catladder",
    "dev:apps": "turbo run dev",
    "test:ports": "node --test scripts/ensure-base-port.test.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "test:screenshot": "node --test scripts/screenshot.test.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "test:db-setup": "node --test scripts/db-setup.test.mjs"
  },
  "devDependencies": {
    "@catladder/cli": "catalog:build-tools",
    "dotenv": "^18.0.5",
    "playwright": "^1.63.0",
    "turbo": "catalog:build-tools"
  }
}
